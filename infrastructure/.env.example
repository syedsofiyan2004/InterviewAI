# Bedrock Inference Profile ARNs (APAC/ap-south-1)
# Create a local .env file in this directory and paste your real ARNs there.
# Do NOT commit your real .env file.
BEDROCK_SONNET_PROFILE_ARN=arn:aws:bedrock:ap-south-1:XXXXXX:inference-profile/apac.anthropic.claude-3-5-sonnet-20241022-v2:0
# Optional: Claude Sonnet 4.6 profile for interview evaluation
BEDROCK_SONNET_46_PROFILE_ARN=arn:aws:bedrock:ap-south-1:XXXXXX:inference-profile/global.anthropic.claude-sonnet-4-6
# BEDROCK_HAIKU_PROFILE_ARN is no longer used
BEDROCK_NOVA_PROFILE_ARN=arn:aws:bedrock:ap-south-1:XXXXXX:inference-profile/apac.amazon.nova-pro-v1:0

# Safety Gate: Set to true only if you want to allow base model fallbacks when profiles are missing
ALLOW_BEDROCK_BASE_MODEL_FALLBACK=false

# Environment Configuration
NODE_ENV=dev
AWS_REGION=ap-south-1

# Interview Intelligence V2 integration modes.
# Use live only after the Keka API application and Microsoft Graph permissions are approved.
KEKA_INTEGRATION_MODE=mock
TEAMS_INTEGRATION_MODE=mock

KEKA_BASE_URL=
KEKA_CLIENT_ID=
KEKA_CLIENT_SECRET=
KEKA_API_KEY=
KEKA_SCOPE=

# Recommended for deployed environments. Store JSON with baseUrl, clientId,
# clientSecret, apiKey, and optional scope in AWS Secrets Manager; do not commit values.
KEKA_SECRET_ARN=

# Set TEAMS_INTEGRATION_MODE=live only after this secret exists and the
# Teams Application Access Policy is granted to approved meeting organisers.
# The secret JSON must contain tenantId, clientId, and clientSecret.
# Never place the actual secret value in .env, frontend code, or Git.
MS_TEAMS_SECRET_ARN=
