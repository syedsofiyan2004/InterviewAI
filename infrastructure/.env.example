# Bedrock Inference Profile ARNs (APAC/ap-south-1)
# Create a local .env file in this directory and paste your real ARNs there.
# Do NOT commit your real .env file.
BEDROCK_SONNET_PROFILE_ARN=arn:aws:bedrock:ap-south-1:XXXXXX:inference-profile/apac.anthropic.claude-3-5-sonnet-20241022-v2:0
# Optional: Claude Sonnet 4.6 profile for interview evaluation
BEDROCK_SONNET_46_PROFILE_ARN=arn:aws:bedrock:ap-south-1:XXXXXX:inference-profile/global.anthropic.claude-sonnet-4-6
# Optional: Claude Sonnet 5 inference profile. Use the profile ID or ARN; direct base-model invocation is not supported in some regions.
BEDROCK_SONNET_5_PROFILE_ARN=global.anthropic.claude-sonnet-5
# BEDROCK_HAIKU_PROFILE_ARN is no longer used
BEDROCK_NOVA_PROFILE_ARN=arn:aws:bedrock:ap-south-1:XXXXXX:inference-profile/apac.amazon.nova-pro-v1:0

# Safety Gate: Set to true only if you want to allow base model fallbacks when profiles are missing
ALLOW_BEDROCK_BASE_MODEL_FALLBACK=false

# Environment Configuration
NODE_ENV=dev
AWS_REGION=ap-south-1

# Interview Intelligence V2 integration modes.
# Use live only after the Keka API application and Microsoft Graph permissions are approved.
KEKA_INTEGRATION_MODE=disabled
TEAMS_INTEGRATION_MODE=disabled

KEKA_BASE_URL=
KEKA_CLIENT_ID=
KEKA_CLIENT_SECRET=
KEKA_API_KEY=
KEKA_SCOPE=

# Recommended for deployed environments. Store JSON with baseUrl, clientId,
# clientSecret, apiKey, and optional scope in AWS Secrets Manager; do not commit values.
KEKA_SECRET_ARN=

# --- My Interviews schedule sweep ---------------------------------------------
# Which candidates the sweep walks. 'filtered' (default) trusts the status list
# below and keeps the run to a few hundred Keka calls. 'all' walks every candidate
# of every job — necessary for a tenant whose candidate records carry no usable
# status field, and far more expensive, so pair it with a longer rate.
KEKA_SYNC_STATUS_MODE=filtered
# Comma-separated Keka candidate statuses that count as interview-active. Required
# when KEKA_SYNC_STATUS_MODE=filtered; the sweep refuses to run without it rather
# than silently walking the whole tenant.
KEKA_INTERVIEW_ACTIVE_STATUSES=
# How often the EventBridge rule fires the sweep. Minutes takes precedence and is
# clamped to 15-1440. Hours is kept as a backward-compatible fallback.
KEKA_SYNC_RATE_MINUTES=30
KEKA_SYNC_RATE_HOURS=6
# How far either side of now an interview is indexed into My Interviews. Blank
# uses the defaults (7 back, 30 forward), clamped to 730 and 365.
# Raise the lookback to bring already-completed rounds into My Interviews — a
# tenant switching the feature on usually has months of past interviews and none
# in the next 30 days, and with the default only the last week is visible. Extra
# lookback costs no extra Keka calls: the window only filters interviews the sweep
# has already fetched.
KEKA_SYNC_LOOKBACK_DAYS=
KEKA_SYNC_LOOKAHEAD_DAYS=

# Set TEAMS_INTEGRATION_MODE=live only after this secret exists and the
# Teams Application Access Policy is granted to approved meeting organisers.
# The secret JSON must contain tenantId, clientId, and clientSecret.
# Never place the actual secret value in .env, frontend code, or Git.
MS_TEAMS_SECRET_ARN=

# MOM Analyzer model. Defaults to Claude Sonnet 5 in CDK when omitted.
MOM_MODEL_ID=global.anthropic.claude-sonnet-5

# Calculator-only semantic routing. These do not change Interview, MOM or Intelligence.
CALCULATOR_FAST_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
CALCULATOR_REASONING_MODEL_ID=global.anthropic.claude-sonnet-4-6
CALCULATOR_MODEL_ROUTING_MODE=hybrid

# Admin Portal seed. Email of the first user promoted to ADMIN + OWNER tier by
# scripts/seed-admin.ts. Must match a Cognito pool user. Leave blank to skip
# seeding an admin (memberships still backfill). Never commit a real value.
SEED_ADMIN_EMAIL=

# Cognito verification-email delivery. Leave COGNITO_SES_FROM_ADDRESS blank to use
# Cognito's built-in sender (no-reply@verificationemail.com): capped at 50 emails/day
# for the whole AWS account, and routinely quarantined by corporate mail gateways
# because the address is shared across AWS accounts and cannot be DKIM-aligned with
# the recipient's domain. Set it to an address on an SES-verified domain to send from
# our own SES account instead.
#
# Do NOT set this until BOTH are true in the SES region, or sign-up breaks for every
# user rather than only the ones behind a gateway:
#   1. the sending domain is verified in SES (DKIM CNAMEs published)
#   2. the account has SES production access (out of the sandbox)
# Verify with: aws sesv2 get-account --region ap-south-1
COGNITO_SES_FROM_ADDRESS=
COGNITO_SES_FROM_NAME=
COGNITO_SES_REPLY_TO_ADDRESS=
# Set to the domain if you verified a DOMAIN in SES rather than a single address, e.g.
# mail.minfytech.com. Points the SES SourceArn at the domain identity. Verifying the
# domain is preferred: one round of DNS records and any From address under it works.
COGNITO_SES_VERIFIED_DOMAIN=
# SES region for the verified identity. Defaults to the stack region (ap-south-1),
# which is supported for ap-south-1 user pools. Only set to override.
COGNITO_SES_REGION=
