{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "es2022"
    ],
    "declaration": true,
    // Nothing in this package consumes emitted JS: the CDK app runs through
    // `ts-node --prefer-ts-exts`, Lambdas are bundled from .ts by esbuild, and
    // Jest compiles through ts-jest. An emit only drops stale .js/.d.ts shadows
    // beside their sources, which esbuild then bundles in place of the real
    // code — silently shipping an old Lambda. Type-check only.
    "noEmit": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": false,
    "inlineSourceMap": true,
    "inlineSources": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "skipLibCheck": true,
    "typeRoots": [
      "./node_modules/@types"
    ],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },

  "exclude": [
    "node_modules",
    "cdk.out"
  ]
}
